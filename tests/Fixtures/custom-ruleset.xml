<?xml version="1.0" encoding="utf-8"?>
<ruleset name="focused">
  <description>Focused naming policy for a repository.</description>
  <rule ref="rulesets/naming.xml">
    <exclude name="ShortClassName" />
    <priority>2</priority>
    <properties>
      <property name="maximum" value="12" />
    </properties>
  </rule>
  <rule ref="LongVariable">
    <priority>1</priority>
    <properties>
      <property name="maximum" value="35" />
    </properties>
  </rule>
</ruleset>
